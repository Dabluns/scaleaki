{
  "manifest_version": 3,
  "name": "Scaleaki - Ad Toolkit",
  "version": "1.0.0",
  "description": "Ferramenta oficial do Scaleaki para garimpo, download de criativos e análise na Biblioteca de Anúncios do Facebook.",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.scaleaki.site/*",
    "http://localhost:3000/*",
    "http://localhost:4000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/ads/library/*"],
      "css": ["style.css"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
