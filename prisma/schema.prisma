generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/**
 * Tier de PRODUTO (escada de acesso). Independente do período de cobrança (UserPlan).
 */
enum PlanTier {
  free
  basico
  plus
}

enum UserPlan {
  free
  mensal
  trimestral
  anual
}

// Enum para Linguagem
enum Linguagem {
  pt_BR
  en_US
  es_ES
  fr_FR
}

model User {
  id                       String        @id @default(uuid())
  email                    String        @unique
  password                 String
  name                     String
  role                     UserRole      @default(user)
  plan                     UserPlan      @default(free)
  tier                     PlanTier      @default(free)
  isActive                 Boolean       @default(true)
  lastLoginAt              DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  emailConfirmed           Boolean       @default(false)
  emailConfirmationToken   String?
  emailConfirmationExpires DateTime?
  firstLoginIp             String?
  apiKeys                  ApiKey[]
  favoritos                Favorito[]
  ofertaViews              OfertaView[]
  anuncioViews             AnuncioView[]
  garimpoLogs              GarimpoLog[]
  payments                 Payment[]
  subscription             Subscription?
  profile                  UserProfile?
  settings                 UserSettings?
  webhooks                 Webhook[]
  placaRequests            PlacaRequest[]
  funnelExtractions        FunnelExtraction[]
}

model AdminAuditLog {
  id              String   @id @default(uuid())
  adminId         String
  adminEmail      String
  action          String
  targetUserId    String
  targetUserEmail String
  details         String?
  createdAt       DateTime @default(now())

  @@index([adminId, action, createdAt])
  @@index([targetUserId, createdAt])
}

model Nicho {
  id        String   @id @default(uuid())
  nome      String
  slug      String   @unique
  icone     String
  descricao String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ofertas   Oferta[]

  @@index([slug])
  @@index([isActive])
}

model Oferta {
  id            String            @id @default(uuid())
  titulo        String
  imagem        String?
  texto         String
  nichoId       String
  plataforma    PlataformaAnuncio @default(facebook_ads)
  tipoOferta    TipoOferta        @default(ecommerce)
  status        StatusOferta      @default(ativa)
  tags          String?
  linguagem     Linguagem         @default(pt_BR)
  links         String
  metricas      String?
  vsl           String?
  receita       Float?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  vslDescricao  String?
  // Bot import tracking fields
  driveFileId   String?           @unique
  importSource  String? // 'bot_v1', 'manual', 'api'
  importStatus  String? // 'complete', 'partial', 'failed'
  importDetails String? // JSON with import details
  importedAt    DateTime?
  favoritos     Favorito[]
  nicho         Nicho             @relation(fields: [nichoId], references: [id], onDelete: Cascade)
  views         OfertaView[]

  @@index([nichoId])
  @@index([plataforma])
  @@index([tipoOferta])
  @@index([status])
  @@index([linguagem])
  @@index([isActive])
  @@index([createdAt])
  @@index([isActive, status])
  @@index([isActive, plataforma])
  @@index([isActive, tipoOferta])
  @@index([isActive, nichoId])
  @@index([isActive, linguagem])
  @@index([isActive, createdAt(sort: Desc)])
  @@index([isActive, plataforma, tipoOferta, status])
  @@index([isActive, nichoId, status])
  @@index([driveFileId])
  @@index([importSource])
}

model Favorito {
  id        String   @id @default(uuid())
  userId    String
  ofertaId  String
  createdAt DateTime @default(now())
  oferta    Oferta   @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ofertaId])
  @@index([userId])
  @@index([ofertaId])
}

model OfertaView {
  id       String   @id @default(uuid())
  userId   String
  ofertaId String
  viewedAt DateTime @default(now())
  oferta   Oferta   @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ofertaId])
  @@index([userId])
  @@index([ofertaId])
  @@index([viewedAt])
}

model AnuncioView {
  id        String   @id @default(uuid())
  userId    String
  anuncioId String
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, anuncioId])
  @@index([userId, viewedAt])
}

model GarimpoLog {
  id         String   @id @default(uuid())
  userId     String
  fbAdId     String
  garimpedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fbAdId])
  @@index([userId, garimpedAt])
}

model UserSettings {
  id                   String    @id @default(uuid())
  userId               String    @unique
  theme                String    @default("auto")
  accentColor          String    @default("#10b981")
  density              String    @default("comfortable")
  fontSize             String    @default("medium")
  language             Linguagem @default(pt_BR)
  defaultLayout        String    @default("grid")
  itemsPerPage         Int       @default(25)
  defaultSort          String    @default("createdAt")
  showMetricsOnCard    Boolean   @default(true)
  autoRefresh          Boolean   @default(false)
  refreshInterval      Int?      @default(300)
  emailNewOffers       Boolean   @default(true)
  emailNewOffersFreq   String    @default("immediate")
  emailRecommendations Boolean   @default(true)
  emailRecoFrequency   String    @default("weekly")
  emailRecoTime        String?   @default("09:00")
  emailRecoDayOfWeek   Int?      @default(1)
  emailPerformance     Boolean   @default(true)
  emailPerfMinRoi      Float?    @default(100.0)
  emailPerfMinCtr      Float?    @default(2.0)
  emailWeeklySummary   Boolean   @default(false)
  emailUpdates         Boolean   @default(true)
  emailNewsletter      Boolean   @default(false)
  inAppNewOffers       Boolean   @default(true)
  inAppSimilar         Boolean   @default(true)
  inAppPerformance     Boolean   @default(false)
  inAppFrequency       String    @default("realtime")
  pushEnabled          Boolean   @default(false)
  pushSubscription     String?
  pushHighPerformance  Boolean   @default(false)
  pushMinRoi           Float?    @default(150.0)
  pushMinCtr           Float?    @default(3.0)
  pushReminders        Boolean   @default(false)
  pushReminderDays     Int?      @default(7)
  profilePublic        Boolean   @default(false)
  showActivities       Boolean   @default(false)
  shareStats           Boolean   @default(false)
  favoriteNichos       String?
  preferredPlataformas String?
  defaultStatus        String?   @default("[\"ativa\",\"pausada\",\"teste\"]")
  preferredTipoOferta  String?
  minRoi               Float?
  minCtr               Float?
  preferredLanguages   String?   @default("[\"pt_BR\"]")
  recoAlgorithm        String    @default("hybrid")
  recoFrequency        String    @default("medium")
  recoDiversity        String    @default("balanced")
  excludedNichos       String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  animationsEnabled    Boolean   @default(true)
  cards3DEnabled       Boolean   @default(true)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  avatar               String?
  avatarType           String?  @default("initials")
  phone                String?
  company              String?
  position             String?
  bio                  String?
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiKey {
  id        String   @id @default(uuid())
  userId    String
  name      String
  key       String   @unique
  keyPrefix String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyPrefix])
}

model Webhook {
  id        String       @id @default(uuid())
  userId    String
  name      String
  url       String
  secret    String?
  events    String
  headers   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs      WebhookLog[]

  @@index([userId])
}

model WebhookLog {
  id           String   @id @default(uuid())
  webhookId    String
  event        String
  payload      String?
  response     String?
  statusCode   Int?
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

model Subscription {
  id                  String             @id @default(uuid())
  userId              String             @unique
  caktoSubscriptionId String?            @unique
  caktoCustomerId     String?
  plan                UserPlan           @default(mensal)
  status              SubscriptionStatus @default(trial)
  startDate           DateTime           @default(now())
  endDate             DateTime?
  trialEndDate        DateTime?
  cancelledAt         DateTime?
  amount              Float
  currency            String             @default("BRL")
  isRecurring         Boolean            @default(true)
  autoRenew           Boolean            @default(true)
  metadata            String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  payments            Payment[]
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([caktoSubscriptionId])
  @@index([caktoCustomerId])
}

model Payment {
  id                 String         @id @default(uuid())
  userId             String
  subscriptionId     String?
  caktoPaymentId     String?        @unique
  caktoTransactionId String?
  amount             Float
  currency           String         @default("BRL")
  status             PaymentStatus  @default(pending)
  paymentMethod      PaymentMethod?
  description        String?
  metadata           String?
  paidAt             DateTime?
  expiresAt          DateTime?
  webhookData        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  subscription       Subscription?  @relation(fields: [subscriptionId], references: [id])
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([caktoPaymentId])
  @@index([caktoTransactionId])
  @@index([createdAt])
}

enum PlataformaAnuncio {
  facebook_ads
  google_ads
  tiktok_ads
  instagram_ads
  linkedin_ads
  twitter_ads
  pinterest_ads
  snapchat_ads
}

enum TipoOferta {
  ecommerce
  lead_generation
  app_install
  brand_awareness
  video_views
  conversions
  traffic
}

enum StatusOferta {
  ativa
  pausada
  arquivada
  teste
}

enum UserRole {
  admin
  moderator
  user
}

enum PaymentStatus {
  pending
  processing
  paid
  failed
  cancelled
  refunded
}

enum SubscriptionStatus {
  active
  cancelled
  expired
  suspended
  trial
}

enum PaymentMethod {
  credit_card
  debit_card
  pix
  boleto
  bank_transfer
}

// ========== BOT STATE & LOGS ==========

model BotState {
  id             String    @id @default("singleton")
  isRunning      Boolean   @default(false)
  lastCycleAt    DateTime?
  lastSuccessAt  DateTime?
  lastErrorAt    DateTime?
  lastError      String?
  totalCycles    Int       @default(0)
  totalOffers    Int       @default(0)
  totalErrors    Int       @default(0)
  startedAt      DateTime?
  stoppedAt      DateTime?
  currentCycleId String?
  config         String? // JSON com configurações dinâmicas
  updatedAt      DateTime  @updatedAt
}

model BotLog {
  id        String   @id @default(uuid())
  level     String // 'info', 'success', 'warning', 'error'
  message   String
  details   String? // JSON com metadados
  offerName String? // Nome da oferta sendo processada
  cycleId   String? // UUID do ciclo atual
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([cycleId])
  @@index([createdAt(sort: Desc)])
}

// ========== FACEBOOK AD LIBRARY ==========

model AnuncioFacebook {
  id String @id @default(uuid())

  // --- Fonte 1: Facebook Ad Library API Oficial ---
  fbAdId             String    @unique // ID único da Ad Library (evita duplicatas)
  pageId             String? // ID da página anunciante
  pageName           String? // Nome da página anunciante
  adCopy             String? // Texto/copy do anúncio (ad_creative_bodies)
  adHeadline         String? // Headline do criativo (ad_creative_link_titles)
  adCaption          String? // Legenda do link (ad_creative_link_captions)
  adDescription      String? // Descrição do link (ad_creative_link_descriptions)
  adSnapshotUrl      String? // URL do embed do criativo na Biblioteca
  destinationUrl     String? // URL de destino da oferta
  libraryUrl         String? // Link direto para a Biblioteca do FB
  publisherPlatforms String? // JSON array: ["facebook","instagram"]
  deliveryStartTime  DateTime? // Data de início da veiculação
  deliveryStopTime   DateTime? // Data de fim (null = ainda ativo)
  spendRange         String? // Faixa de gasto (ex: "<100", "100-499")
  impressionsRange   String? // Faixa de impressões (ex: "1K-5K")
  currency           String? // Moeda (BRL, USD, etc.)

  // --- Fonte 1b: Graph API (/{page_id}?fields=...) ---
  pageProfilePic String? // URL da foto da página
  pageLikes      Int? // Curtidas da página (fan_count)

  // --- Fonte 2: Scraper Playwright (interface pública Ad Library) ---
  duplicatas     Int?      @default(0) // collationCount: "X anúncios usam esse criativo"
  scraperLastRun DateTime? // Última vez que o scraper atualizou esse registro

  // --- Fonte 3: URLscan.io (Análise de Funil) ---
  urlscanUuid       String? // UUID do scan no URLscan
  checkout          String? // Plataforma detectada (Shopify, Kiwify, Hotmart...)
  tecnologia        String? // Stack do site (Wordpress, VTEX, Webflow...)
  funnelSubdomains  String? // JSON array de subdomínios do funil
  activePixels      String? // JSON array de pixels ativos
  landingScreenshot String? // URL do screenshot PNG da landing page
  externalServices  String? // JSON array de serviços externos detectados
  urlscanLastRun    DateTime? // Última vez que o URLscan atualizou esse registro

  // --- Curadoria Manual (Admin) ---
  escala Int? @default(0) // Score de escala definido pelo curador

  // --- Controle ---
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fbAdId])
  @@index([pageId])
  @@index([isActive])
  @@index([deliveryStartTime])
  @@index([checkout])
  @@index([escala])
  @@index([duplicatas])
  @@index([isActive, deliveryStartTime(sort: Desc)])
  @@index([isActive, escala(sort: Desc)])
  @@index([isActive, duplicatas(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────────────
// SCALEAKI+ — Features premium (tier plus)
// ─────────────────────────────────────────────────────────────────────────────

/** Origem do produto escalado (uma tabela p/ os 5 marketplaces). */
enum ProductSource {
  dropshipping
  mercadolivre
  aliexpress
  shopee
  shein
}

/** Produto escalado / em promoção coletado por scraper de marketplace. */
model ScaledProduct {
  id String @id @default(uuid())

  source      ProductSource
  externalId  String // ID do produto na origem (MLB123, item id, etc.)
  title       String
  description String?
  imageUrl    String?
  productUrl  String // URL canônica do produto na origem
  storeName   String? // Loja/vendedor

  price          Float? // Preço atual
  originalPrice  Float? // Preço cheio (antes do desconto)
  discountPct    Int? // % de desconto
  currency       String? @default("BRL")

  soldCount   Int?    @default(0) // Vendas/pedidos (sinal de escala)
  rating      Float? // Avaliação média
  reviewCount Int?    @default(0)
  category    String?

  escala       Int?      @default(0) // Score de escala (vendas + recência)
  isActive     Boolean   @default(true)
  scraperLastRun DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([source, externalId])
  @@index([source])
  @@index([isActive])
  @@index([source, isActive, escala(sort: Desc)])
  @@index([source, isActive, soldCount(sort: Desc)])
  @@index([source, isActive, discountPct(sort: Desc)])
}

/** Plataforma do anúncio escalado (ad spy). */
enum AdPlatform {
  youtube
  tiktok
}

/** Anúncio escalado coletado de YouTube Ads / TikTok Ads. */
model ScaledAd {
  id String @id @default(uuid())

  platform   AdPlatform
  externalId String // ID do anúncio/vídeo na plataforma
  advertiser String? // Anunciante
  title      String?
  adCopy     String?
  thumbnailUrl String?
  videoUrl   String? // URL do criativo (quando público)
  landingUrl String? // URL de destino

  views       Int?    @default(0)
  likes       Int?    @default(0)
  shares      Int?    @default(0)
  ctaText     String? // CTA do anúncio
  region      String? @default("BR")

  firstSeen DateTime?
  lastSeen  DateTime?

  escala         Int?      @default(0)
  isActive       Boolean   @default(true)
  scraperLastRun DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([platform, externalId])
  @@index([platform])
  @@index([isActive])
  @@index([platform, isActive, escala(sort: Desc)])
  @@index([platform, isActive, views(sort: Desc)])
}

/** Scaleflix — videoaulas de como usar o Scaleaki. */
model ScaleflixVideo {
  id String @id @default(uuid())

  title       String
  description String?
  thumbnailUrl String?
  videoUrl    String // Embed/stream URL (YouTube/Vimeo/Mux)
  durationSec Int? // Duração em segundos
  module      String? // Módulo/categoria (Onboarding, Avançado...)
  ordem       Int     @default(0) // Ordem de exibição

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([module])
  @@index([isActive, ordem])
}

/** Status da solicitação de placa de faturamento. */
enum PlacaStatus {
  pendente
  aprovada
  enviada
  rejeitada
}

/** Solicitação de placa de faturamento (milestone com o Scaleaki). */
model PlacaRequest {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  faturamento  Float // Faturamento declarado no período
  periodo      String // Ex: "2026-06" ou "Q2 2026"
  comprovante  String? // URL do comprovante (print/extrato)
  observacao   String?

  status      PlacaStatus @default(pendente)
  adminNote   String? // Nota do revisor
  trackingUrl String? // Rastreio do envio físico

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/** Extração de funil (URL → mapa do funil). Reusa stack URLscan. */
model FunnelExtraction {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  domain        String // Domínio/URL analisado
  checkout      String? // Plataforma de checkout detectada
  tecnologia    String? // Stack do site
  subdomains    String? // JSON array de subdomínios do funil
  activePixels  String? // JSON array de pixels
  externalServices String? // JSON array de serviços externos
  screenshot    String? // Screenshot da landing
  redirectChain String? // JSON array da cadeia de redirects
  urlscanUuid   String?

  // Estimativa de tráfego (SimilarWeb-like, MVP)
  estimatedVisits Int? // Visitas/mês estimadas (quando provider disponível)
  trafficSources  String? // JSON: distribuição de fontes
  topCountries    String? // JSON array

  status    String   @default("pending") // pending | done | failed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([domain])
}
